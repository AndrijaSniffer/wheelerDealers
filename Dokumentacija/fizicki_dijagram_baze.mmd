    CAR ||--o{ IMAGE : "car_id"
    MODEL ||--o{ CAR : "model_id"
    TRANSMISSIONTYPE ||--o{ CAR : "transmission_type_id"
    FUEL ||--o{ CAR : "fuel_id"
    DRIVETRAIN ||--o{ CAR : "drivetrain_id"
    ENGINETYPE ||--o{ CAR : "engine_type_id"
    EMISSIONCLASS ||--o{ CAR : "emission_class_id"
    
    MANUFACTURER ||--o{ MODEL : "manufacturer_id"
