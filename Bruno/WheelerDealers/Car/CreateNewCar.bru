meta {
  name: CreateNewCar
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/car/
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  user: 1
  model: 1
  transmission_type: 1
  fuel: 1
  drivetrain: 1
  engine_type: 1
  emission_class: 1
  year: 2020
  horsepower: 158
  kilowatt: 116
  engine_volume: 1500
  gears: 6
  doors: 4
  seats: 5
  steering_wheel_left: true
  interior_color: Black
  price: 15000
  exterior_color: Blue
  chassis_number: WBA3A5C50DF596638
  is_preowned: true
}

settings {
  encodeUrl: true
}
